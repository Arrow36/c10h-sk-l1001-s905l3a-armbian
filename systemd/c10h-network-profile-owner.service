[Unit]
Description=Restore ownership of C10H NetworkManager profiles after Android mounts
After=local-fs.target
Before=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for f in /etc/NetworkManager/system-connections/*.nmconnection; do [ ! -f "$f" ] || chown 0:0 "$f"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
